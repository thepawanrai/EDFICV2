# EDFIC - EWA Diagnostic and Fetal Imaging Centre (A Unit of EWA DERMA)
# Safe environment variable template (configure real values in Hostinger Environment Variables)

# Server Configuration
NODE_ENV=""
PORT=""
APP_URL=""

# Database Configuration
# Hostinger MySQL example: mysql://DB_USER:DB_PASSWORD@HOST:3306/DB_NAME
# Local SQLite fallback if left unset during preview: file:./dev.db
DATABASE_URL=""

# Seed Control (set to "true" in production)
DISABLE_DEV_SEED=""

# Authentication & Security Secrets (generate strong random 32+ char strings in production)
JWT_SECRET=""
CSRF_SECRET=""

# Restricted Agent API Key
HERMES_API_KEY=""

# Google Maps Platform Browser Key (optional, HTTP-referrer restricted)
VITE_GOOGLE_MAPS_API_KEY=""
GOOGLE_MAPS_API_KEY=""

# Server-Side Gemini API Key (optional)
GEMINI_API_KEY=""

# n8n Automation Integration (optional)
N8N_WEBHOOK_URL=""
N8N_WEBHOOK_SECRET=""
N8N_API_KEY=""

# WhatsApp Business API Provider Configuration (optional)
WHATSAPP_PROVIDER=""
WHATSAPP_API_URL=""
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_WEBHOOK_SECRET=""
